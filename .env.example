# NameNotFound - local environment variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# .env is ignored by Git. Never commit real values.

# Password for the SQL Server "sa" account (local development only).
# Requirements: at least 8 characters, using three of these four sets:
# uppercase letters, lowercase letters, digits and symbols.
# If the password does not meet them, the container stops.
MSSQL_SA_PASSWORD=

# Port on this machine that maps to SQL Server (optional, default 1433).
# Change it if 1433 is already in use.
MSSQL_HOST_PORT=1433
